{
  "name": "mennis",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "deploy:staging": "node scripts/sanity-deploy.mjs staging studio",
    "deploy:production": "node scripts/sanity-deploy.mjs production studio",
    "deploy-graphql:staging": "node scripts/sanity-deploy.mjs staging graphql",
    "deploy-graphql:production": "node scripts/sanity-deploy.mjs production graphql"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@astro-mennis/media-contract": "file:../shared/media-contract",
    "@sanity/vision": "5.26.0",
    "react": "^19.1",
    "react-dom": "^19.1",
    "sanity": "5.26.0",
    "styled-components": "^6.1.18"
  },
  "overrides": {
    "react-is": "^19.2.6"
  },
  "devDependencies": {
    "@sanity/cli": "6.6.0",
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.1",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "typescript": "^5.8",
    "vite": "^7.3.2"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
