---
import VideoPreview from "./VideoPreview.astro"
import { imageAttributes, youtubeId as parseYouTubeId } from "../lib/media"

type WorkVideo = { title: string; youtubeUrl: string; poster?: string }
type WorkMedia =
  | { mode: "preview" }
  | { mode: "single"; youtubeUrl?: string }
  | { mode: "gallery"; videos?: WorkVideo[] }
  | { mode: "slider"; reels?: string[] }

const { work } = Astro.props as {
  work: {
    title?: string
    preview: { poster: string; mp4?: string; webm?: string }
    media?: WorkMedia
  }
}

function getYouTubeId(input?: string | null): string | null {
  return parseYouTubeId(input) ?? null
}

const media = work.media
const youtubeId = media && media.mode === "single" ? getYouTubeId(media.youtubeUrl ?? null) : null
const galleryItems =
  media && media.mode === "gallery"
    ? (media.videos ?? [])
        .flatMap((video, index) => {
          const id = getYouTubeId(video.youtubeUrl)
          if (!id) return []
          const poster = imageAttributes({
            src: video.poster ?? work.preview.poster,
            widths: [320, 480, 720, 1024, 1280],
            fallbackWidth: 1280,
            sizes: "(max-width: 72rem) calc(100vw - 2rem), 72rem",
          })
          return [{
            id,
            title: video.title?.trim() || `Video ${index + 1}`,
            poster,
            posterSrc: poster.src ?? video.poster ?? work.preview.poster,
          }]
        })
        .slice(0, 6)
    : []
const reelIds =
  media && media.mode === "slider"
    ? (media.reels ?? [])
        .map(u => getYouTubeId(u))
        .filter((x): x is string => Boolean(x))
        .slice(0, 8)
    : []

const hasYouTube = Boolean(youtubeId)
const hasGallery = galleryItems.length > 0
const hasSlider = reelIds.length > 0
const hasGalleryNav = galleryItems.length > 1
const hasSliderNav = reelIds.length > 1
const singleMediaLabel = work.title?.trim() ? `video for ${work.title.trim()}` : "project video"
const singleStatusId = youtubeId ? `work-media-status-${youtubeId}` : undefined
const facadeSizes = hasSlider
  ? "(max-width: 30rem) 86vw, 420px"
  : "(max-width: 72rem) calc(100vw - 2rem), 72rem"
const facadePoster = imageAttributes({
  src: work.preview.poster,
  widths: [320, 480, 720, 1024, 1280],
  fallbackWidth: hasSlider ? 720 : 1280,
  sizes: facadeSizes,
})
const facadePosterSrc = facadePoster.src ?? work.preview.poster
---

<div data-work-hero>
  {
    hasYouTube ? (
      <div class="hero-16x9">
        <div class="yt-frame yt-frame--16x9" data-yt-frame>
          <div
            class="yt-embed"
            data-yt-embed
            data-yt-video-id={youtubeId}
            data-yt-ratio="16:9"
            data-yt-title={singleMediaLabel}
            inert
            aria-hidden="true"
          />
          <button
            class="yt-overlay"
            type="button"
            aria-label={`Play ${singleMediaLabel} on YouTube`}
            aria-describedby={singleStatusId}
            data-yt-overlay
          >
            <img
              class="yt-overlay__img"
              alt=""
              loading="eager"
              decoding="async"
              fetchpriority="high"
              width="1280"
              height="720"
              src={facadePosterSrc}
              srcset={facadePoster.srcset}
              sizes={facadePoster.sizes}
            />
            <span class="yt-overlay__play" aria-hidden="true" />
          </button>
          <div class="yt-feedback">
            <p
              class="yt-status sr-only"
              id={singleStatusId}
              data-yt-status
              role="status"
              aria-live="polite"
              aria-atomic="true"
            />
            <button
              class="yt-retry ds-pill ds-kicker ds-kicker--compact"
              type="button"
              data-yt-retry
              hidden
            >
              Retry {singleMediaLabel}
            </button>
          </div>
        </div>
      </div>
    ) : hasGallery ? (
      <section
        class="yt-gallery yt-gallery--landscape"
        aria-label={work.title?.trim() ? `Videos for ${work.title.trim()}` : "Project videos"}
      >
        {hasGalleryNav ? (
          <button
            class="yt-gallery__control yt-gallery__control--prev ds-pill ds-kicker ds-kicker--compact"
            type="button"
            aria-label="Previous video"
            data-yt-prev
            hidden
          >
            <svg
              class="yt-gallery__control-icon yt-gallery__control-icon--prev"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M8 4L16 12L8 20" />
            </svg>
          </button>
        ) : null}

        <div class="yt-rail yt-rail--landscape" data-yt-rail>
          {galleryItems.map((video, index) => {
            const mediaLabel = `${video.title}, video ${index + 1} of ${galleryItems.length}`
            const statusId = `work-media-status-gallery-${video.id}-${index}`

            return (
              <article
                class="yt-slide yt-slide--landscape"
                data-yt-slide
                aria-label={`Video ${index + 1} of ${galleryItems.length}: ${video.title}`}
                aria-current={index === 0 ? "true" : undefined}
                aria-hidden={index === 0 ? undefined : "true"}
                inert={index === 0 ? undefined : true}
              >
                <div class="yt-frame yt-frame--16x9" data-yt-frame>
                  <div
                    class="yt-embed"
                    data-yt-embed
                    data-yt-video-id={video.id}
                    data-yt-ratio="16:9"
                    data-yt-title={mediaLabel}
                    inert
                    aria-hidden="true"
                  />
                  <button
                    class="yt-overlay"
                    type="button"
                    aria-label={`Play ${mediaLabel} on YouTube`}
                    aria-describedby={statusId}
                    data-yt-overlay
                  >
                    <img
                      class="yt-overlay__img"
                      alt=""
                      loading={index === 0 ? "eager" : "lazy"}
                      decoding="async"
                      fetchpriority={index === 0 ? "high" : undefined}
                      width="1280"
                      height="720"
                      src={video.posterSrc}
                      srcset={video.poster.srcset}
                      sizes={video.poster.sizes}
                    />
                    <span class="yt-overlay__play" aria-hidden="true" />
                  </button>
                  <div class="yt-feedback">
                    <p
                      class="yt-status sr-only"
                      id={statusId}
                      data-yt-status
                      role="status"
                      aria-live="polite"
                      aria-atomic="true"
                    />
                    <button
                      class="yt-retry ds-pill ds-kicker ds-kicker--compact"
                      type="button"
                      data-yt-retry
                      hidden
                    >
                      Retry {mediaLabel}
                    </button>
                  </div>
                </div>
                <div class="yt-slide__meta">
                  <span class="yt-slide__title ds-title">{video.title}</span>
                </div>
              </article>
            )
          })}
        </div>

        <div
          class="yt-gallery__pagination"
          data-yt-pagination
          role="group"
          aria-label="Choose a video"
        >
          {galleryItems.map((video, index) => (
            <button
              type="button"
              class:list={["yt-gallery__dot", { "is-active": index === 0 }]}
              aria-label={`Go to video ${index + 1}: ${video.title}`}
              aria-current={index === 0 ? "true" : undefined}
              data-yt-dot
            />
          ))}
        </div>
        <p class="sr-only" data-yt-pagination-status role="status" aria-live="polite">
          Video 1 of {galleryItems.length}: {galleryItems[0].title}
        </p>

        {hasGalleryNav ? (
          <button
            class="yt-gallery__control yt-gallery__control--next ds-pill ds-kicker ds-kicker--compact"
            type="button"
            aria-label="Next video"
            data-yt-next
          >
            <svg
              class="yt-gallery__control-icon"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M8 4L16 12L8 20" />
            </svg>
          </button>
        ) : null}
      </section>
    ) : hasSlider ? (
      <section class="yt-gallery yt-gallery--reels" aria-label="Reels">
        <div class="yt-rail" data-yt-rail>
          {reelIds.map((id, index) => {
            const mediaLabel = `reel ${index + 1} of ${reelIds.length}`
            const statusId = `work-media-status-${id}-${index}`

            return (
              <article class="yt-slide" data-yt-slide>
                <div class="yt-frame yt-frame--9x16" data-yt-frame>
                  <div
                    class="yt-embed"
                    data-yt-embed
                    data-yt-video-id={id}
                    data-yt-ratio="9:16"
                    data-yt-title={mediaLabel}
                    inert
                    aria-hidden="true"
                  />
                  <button
                    class="yt-overlay"
                    type="button"
                    aria-label={`Play ${mediaLabel} on YouTube`}
                    aria-describedby={statusId}
                    data-yt-overlay
                  >
                    <img
                      class="yt-overlay__img"
                      alt=""
                      loading={index === 0 ? "eager" : "lazy"}
                      decoding="async"
                      fetchpriority={index === 0 ? "high" : undefined}
                      width="720"
                      height="1280"
                      src={facadePosterSrc}
                      srcset={facadePoster.srcset}
                      sizes={facadePoster.sizes}
                    />
                    <span class="yt-overlay__play" aria-hidden="true" />
                  </button>
                  <div class="yt-feedback">
                    <p
                      class="yt-status sr-only"
                      id={statusId}
                      data-yt-status
                      role="status"
                      aria-live="polite"
                      aria-atomic="true"
                    />
                    <button
                      class="yt-retry ds-pill ds-kicker ds-kicker--compact"
                      type="button"
                      data-yt-retry
                      hidden
                    >
                      Retry {mediaLabel}
                    </button>
                  </div>
                </div>
              </article>
            )
          })}
        </div>

        {hasSliderNav ? (
          <div class="yt-gallery__controls--reels" role="group" aria-label="Reel navigation">
            <button
              class="yt-gallery__control yt-gallery__control--prev ds-pill ds-kicker ds-kicker--compact"
              type="button"
              aria-label="Previous reel"
              data-yt-prev
              hidden
            >
              <svg
                class="yt-gallery__control-icon yt-gallery__control-icon--prev"
                viewBox="0 0 24 24"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M8 4L16 12L8 20" />
              </svg>
            </button>
            <button
              class="yt-gallery__control yt-gallery__control--next ds-pill ds-kicker ds-kicker--compact"
              type="button"
              aria-label="Next reel"
              data-yt-next
            >
              <svg
                class="yt-gallery__control-icon"
                viewBox="0 0 24 24"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M8 4L16 12L8 20" />
              </svg>
            </button>
          </div>
        ) : null}
      </section>
    ) : (
      <VideoPreview mp4={work.preview.mp4} webm={work.preview.webm} poster={work.preview.poster} />
    )
  }
</div>

<style>
  .hero-16x9 {
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
  }

  .yt-gallery {
    position: relative;
  }

  .yt-gallery--landscape {
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
  }

  .yt-gallery__control {
    position: absolute;
    bottom: 10px;
    z-index: 30;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    min-height: 48px;
    padding: 0;
    border: 2px solid var(--color-brand-secondary);
    border-radius: 50%;
    background-color: var(--color-brand-secondary);
    color: #fff;
    transition:
      border-color 220ms ease,
      background-color 220ms ease,
      color 220ms ease;
  }

  .yt-gallery__control:hover,
  .yt-gallery__control:focus-visible {
    border-color: var(--color-brand-secondary);
    background-color: var(--color-brand-accent);
    color: var(--color-brand-secondary);
  }

  .yt-gallery__control[hidden] {
    display: none;
  }

  .yt-gallery__control--prev {
    left: 1rem;
  }

  .yt-gallery__control--next {
    right: 1rem;
  }

  .yt-gallery__control-icon {
    display: block;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .yt-gallery__control-icon--prev {
    transform: rotate(180deg);
  }

  .yt-gallery__controls--reels {
    position: absolute;
    inset: 0 -29px;
    z-index: 30;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    pointer-events: none;
  }

  .yt-gallery__controls--reels .yt-gallery__control {
    position: static;
    pointer-events: auto;
  }

  .yt-gallery__controls--reels .yt-gallery__control--prev {
    grid-column: 1;
    justify-self: start;
  }

  .yt-gallery__controls--reels .yt-gallery__control--next {
    grid-column: 2;
    justify-self: end;
  }

  .yt-rail {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    touch-action: auto;
    overscroll-behavior-x: contain;
    padding: 10px 0 16px;
  }

  .yt-rail--landscape {
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    touch-action: auto;
    padding-bottom: 38px;
  }

  .yt-rail--landscape::-webkit-scrollbar {
    display: none;
  }

  .yt-slide {
    flex: 0 0 auto;
    display: flex;
    justify-content: center;
  }

  .yt-slide--landscape {
    flex: 0 0 100%;
    display: block;
    scroll-snap-align: start;
  }

  .yt-slide__meta {
    display: flex;
    align-items: baseline;
    justify-content: center;
    padding: 12px 4.5rem 0;
    color: var(--color-brand-secondary);
    text-align: center;
  }

  .yt-slide__title {
    --ds-title-size: clamp(0.95rem, 1.4vw, 1.05rem);
    width: 100%;
    margin-top: 0;
  }

  .yt-gallery__pagination {
    position: absolute;
    left: 50%;
    bottom: 7px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0;
    transform: translateX(-50%);
  }

  .yt-gallery__dot {
    -webkit-appearance: none;
    appearance: none;
    display: grid;
    flex: 0 0 32px;
    place-items: center;
    width: 32px;
    height: 32px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    cursor: pointer;
    touch-action: manipulation;
  }

  .yt-gallery__dot::before {
    content: "";
    box-sizing: content-box;
    display: block;
    width: 10px;
    height: 10px;
    border: 2px solid transparent;
    border-radius: 50%;
    background-color: var(--color-brand-secondary);
    background-clip: padding-box;
    transition:
      border-color 220ms ease,
      background-color 220ms ease;
  }

  .yt-gallery__dot:hover::before,
  .yt-gallery__dot:focus-visible::before,
  .yt-gallery__dot.is-active::before {
    border-color: var(--color-brand-secondary);
    background-color: var(--color-brand-accent);
  }

  .yt-gallery__dot:focus-visible {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: -4px;
  }

  .yt-frame {
    position: relative;
    overflow: hidden;
    border-radius: 0;
    background: var(--color-brand-secondary);
  }

  .yt-frame--16x9 {
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .yt-frame--9x16 {
    width: min(420px, 86vw);
    aspect-ratio: 9 / 16;
  }

  .yt-embed {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .yt-embed[inert] {
    pointer-events: none;
  }

  .yt-embed :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .yt-overlay {
    position: absolute;
    inset: 0;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    z-index: 5;
  }

  .yt-overlay[hidden] {
    display: none;
  }

  .yt-overlay[aria-busy="true"] {
    cursor: progress;
  }

  .yt-overlay__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yt-overlay__play {
    position: absolute;
    top: 50%;
    left: 50%;
    box-sizing: border-box;
    width: 64px;
    height: 64px;
    transform: translate(-50%, -50%);
    border: 2px solid var(--color-brand-secondary);
    border-radius: 50%;
    background-color: var(--color-brand-secondary);
    transition:
      border-color 220ms ease,
      background-color 220ms ease;
  }

  .yt-overlay__play::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-42%, -50%);
    border-left: 18px solid #fff;
    border-top: 12px solid transparent;
    border-bottom: 12px solid transparent;
    transition: border-left-color 220ms ease;
  }

  .yt-overlay:hover .yt-overlay__play,
  .yt-overlay:focus-visible .yt-overlay__play {
    border-color: var(--color-brand-secondary);
    background-color: var(--color-brand-accent);
  }

  .yt-overlay:hover .yt-overlay__play::after,
  .yt-overlay:focus-visible .yt-overlay__play::after {
    border-left-color: var(--color-brand-secondary);
  }

  .yt-overlay:focus-visible {
    outline: none;
  }

  .yt-frame[data-yt-feedback-state="error"] .yt-overlay__play,
  .yt-frame[data-yt-feedback-state="unavailable"] .yt-overlay__play {
    display: none;
  }

  .yt-feedback {
    position: absolute;
    inset: 0;
    z-index: 8;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-sizing: border-box;
    max-height: 100%;
    padding: 1rem;
    overflow-y: auto;
    pointer-events: none;
  }

  .yt-retry {
    position: static;
    box-sizing: border-box;
    max-width: 100%;
    margin: 0;
    min-height: 48px;
    background: var(--color-brand-primary);
    pointer-events: auto;
  }

  .yt-retry:hover,
  .yt-retry:focus-visible {
    border-color: var(--color-brand-secondary);
    background: var(--color-brand-secondary);
    color: var(--color-brand-primary);
  }

  .yt-status {
    pointer-events: none;
  }

  .yt-retry[hidden] {
    display: none;
  }

  @media (min-width: 900px) {
    .yt-frame--9x16 {
      width: 380px;
    }
  }

  @media (max-width: 700px) {
    .yt-gallery__control {
      width: 40px;
      height: 40px;
      min-height: 40px;
    }

    .yt-gallery--landscape .yt-gallery__control {
      bottom: 14px;
    }

    .yt-gallery__controls--reels {
      inset-inline: 12px;
    }

    .yt-gallery__controls--reels .yt-gallery__control {
      border-color: var(--color-brand-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .yt-gallery__dot::before {
      transition: none;
    }

    .yt-gallery__control {
      transition: none;
    }

    .yt-overlay__play {
      transition: none;
    }

    .yt-overlay__play::after {
      transition: none;
    }
  }
</style>

{hasYouTube || hasGallery || hasSlider ? <script src="../scripts/workMediaDisplayScript.ts"></script> : null}
