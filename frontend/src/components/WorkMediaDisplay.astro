---
import "plyr/dist/plyr.css"
import VideoPreview from "./VideoPreview.astro"
import { imageAttributes, youtubeId as parseYouTubeId } from "../lib/media"

type WorkMedia = { mode: "preview" } | { mode: "single"; youtubeUrl?: string } | { mode: "slider"; reels?: string[] }

const { work } = Astro.props as {
  work: {
    title?: string
    preview: { poster: string; mp4?: string; webm?: string }
    media?: WorkMedia
  }
}

function getYouTubeId(input?: string | null): string | null {
  return parseYouTubeId(input) ?? null
}

const media = work.media
const youtubeId = media && media.mode === "single" ? getYouTubeId(media.youtubeUrl ?? null) : null
const reelIds =
  media && media.mode === "slider"
    ? (media.reels ?? [])
        .map(u => getYouTubeId(u))
        .filter((x): x is string => Boolean(x))
        .slice(0, 8)
    : []

const hasYouTube = Boolean(youtubeId)
const hasSlider = reelIds.length > 0
const hasSliderNav = reelIds.length > 1
const singleMediaLabel = work.title?.trim() ? `video for ${work.title.trim()}` : "project video"
const singleStatusId = youtubeId ? `work-media-status-${youtubeId}` : undefined
const facadeSizes = hasSlider
  ? "(max-width: 30rem) 86vw, 420px"
  : "(max-width: 72rem) calc(100vw - 2rem), 72rem"
const facadePoster = imageAttributes({
  src: work.preview.poster,
  widths: [320, 480, 720, 1024, 1280],
  fallbackWidth: hasSlider ? 720 : 1280,
  sizes: facadeSizes,
})
const facadePosterSrc = facadePoster.src ?? work.preview.poster
---

<div data-work-hero>
  {
    hasYouTube ? (
      <div class="hero-16x9">
        <div class="yt-frame yt-frame--16x9" data-yt-frame>
          <div
            class="plyr__video-embed yt-embed"
            data-yt-embed
            data-yt-ratio="16:9"
            data-yt-title={singleMediaLabel}
            data-plyr-provider="youtube"
            data-plyr-embed-id={youtubeId}
            inert
            aria-hidden="true"
          />
          <button
            class="yt-overlay"
            type="button"
            aria-label={`Play ${singleMediaLabel} on YouTube`}
            aria-describedby={singleStatusId}
            data-yt-overlay
          >
            <img
              class="yt-overlay__img"
              alt=""
              loading="eager"
              decoding="async"
              fetchpriority="high"
              width="1280"
              height="720"
              src={facadePosterSrc}
              srcset={facadePoster.srcset}
              sizes={facadePoster.sizes}
            />
            <span class="yt-overlay__play" aria-hidden="true" />
          </button>
          <div class="yt-feedback">
            <p
              class="yt-status"
              id={singleStatusId}
              data-yt-status
              role="status"
              aria-live="polite"
              aria-atomic="true"
            />
            <button class="yt-retry" type="button" data-yt-retry hidden>
              Retry {singleMediaLabel}
            </button>
            <a
              class="yt-fallback"
              data-yt-video-id={youtubeId}
              data-yt-fallback
              hidden
            >
              Watch {singleMediaLabel} on YouTube
            </a>
          </div>
        </div>
      </div>
    ) : hasSlider ? (
      <section class="yt-gallery" aria-label="Reels">
        {hasSliderNav ? (
          <button class="yt-nav yt-nav--prev" type="button" aria-label="Previous" data-yt-prev>
            <span class="yt-nav__chevron" aria-hidden="true"></span>
          </button>
        ) : null}

        <div class="yt-rail" data-yt-rail>
          {reelIds.map((id, index) => {
            const mediaLabel = `reel ${index + 1} of ${reelIds.length}`
            const statusId = `work-media-status-${id}-${index}`

            return (
              <article class="yt-slide" data-yt-slide>
                <div class="yt-frame yt-frame--9x16" data-yt-frame>
                  <div
                    class="plyr__video-embed yt-embed"
                    data-yt-embed
                    data-yt-ratio="9:16"
                    data-yt-title={mediaLabel}
                    data-plyr-provider="youtube"
                    data-plyr-embed-id={id}
                    inert
                    aria-hidden="true"
                  />
                  <button
                    class="yt-overlay"
                    type="button"
                    aria-label={`Play ${mediaLabel} on YouTube`}
                    aria-describedby={statusId}
                    data-yt-overlay
                  >
                    <img
                      class="yt-overlay__img"
                      alt=""
                      loading={index === 0 ? "eager" : "lazy"}
                      decoding="async"
                      fetchpriority={index === 0 ? "high" : undefined}
                      width="720"
                      height="1280"
                      src={facadePosterSrc}
                      srcset={facadePoster.srcset}
                      sizes={facadePoster.sizes}
                    />
                    <span class="yt-overlay__play" aria-hidden="true" />
                  </button>
                  <div class="yt-feedback">
                    <p
                      class="yt-status"
                      id={statusId}
                      data-yt-status
                      role="status"
                      aria-live="polite"
                      aria-atomic="true"
                    />
                    <button class="yt-retry" type="button" data-yt-retry hidden>
                      Retry {mediaLabel}
                    </button>
                    <a
                      class="yt-fallback"
                      data-yt-video-id={id}
                      data-yt-fallback
                      hidden
                    >
                      Watch {mediaLabel} on YouTube
                    </a>
                  </div>
                </div>
              </article>
            )
          })}
        </div>

        {hasSliderNav ? (
          <button class="yt-nav yt-nav--next" type="button" aria-label="Next" data-yt-next>
            <span class="yt-nav__chevron" aria-hidden="true"></span>
          </button>
        ) : null}
      </section>
    ) : (
      <VideoPreview mp4={work.preview.mp4} webm={work.preview.webm} poster={work.preview.poster} />
    )
  }
</div>

<style>
  .hero-16x9 {
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
  }

  .yt-gallery {
    position: relative;
  }

  .yt-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 56px;
    height: 56px;
    border-radius: 0;
    border: 2px solid rgba(255, 255, 255, 0.92);
    background: var(--color-brand-secondary);
    display: grid;
    place-items: center;
    cursor: pointer;
    z-index: 30;
  }

  .yt-nav__chevron {
    width: 13px;
    height: 13px;
    border-top: 4px solid #fff;
    border-right: 4px solid #fff;
  }

  .yt-nav--prev .yt-nav__chevron {
    transform: translateX(3px) rotate(-135deg);
  }

  .yt-nav--next .yt-nav__chevron {
    transform: translateX(-3px) rotate(45deg);
  }

  .yt-nav--prev {
    left: -12px;
  }

  .yt-nav--next {
    right: -12px;
  }

  .yt-rail {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x;
    overscroll-behavior-x: contain;
    padding: 10px 0 16px;
  }

  .yt-slide {
    flex: 0 0 auto;
    display: flex;
    justify-content: center;
  }

  .yt-frame {
    position: relative;
    overflow: hidden;
    border-radius: 0;
    background: var(--color-brand-secondary);
  }

  .yt-frame--16x9 {
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .yt-frame--9x16 {
    width: min(420px, 86vw);
    aspect-ratio: 9 / 16;
  }

  .yt-embed {
    position: absolute;
    inset: 0;
  }

  .yt-frame :global(.plyr),
  .yt-frame :global(.plyr__video-wrapper),
  .yt-frame :global(.plyr__video-embed),
  .yt-frame :global(iframe) {
    width: 100%;
    height: 100%;
  }

  .yt-frame :global(.plyr__poster) {
    display: none;
  }

  .yt-frame :global(.plyr[data-yt-player-locked]) {
    visibility: hidden;
    pointer-events: none;
  }

  .yt-frame :global(.plyr[data-yt-player-unlocking] .plyr__control),
  .yt-frame :global(.plyr[data-yt-player-unlocking] .plyr__controls) {
    transition: none;
  }

  .yt-overlay {
    position: absolute;
    inset: 0;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    z-index: 5;
  }

  .yt-overlay[hidden] {
    display: none;
  }

  .yt-overlay[aria-busy="true"] {
    cursor: progress;
  }

  .yt-overlay__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yt-overlay__play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 76px;
    height: 76px;
    transform: translate(-50%, -50%);
    border-radius: 0;
    background: rgba(255, 255, 255, 0.18);
  }

  .yt-overlay__play::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-42%, -50%);
    border-left: 18px solid rgba(255, 255, 255, 0.9);
    border-top: 12px solid transparent;
    border-bottom: 12px solid transparent;
  }

  .yt-feedback {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    z-index: 8;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    max-height: calc(100% - 24px);
    overflow-y: auto;
    pointer-events: auto;
  }

  .yt-status,
  .yt-retry,
  .yt-fallback {
    position: static;
    box-sizing: border-box;
    max-width: 100%;
    margin: 0;
    padding: 8px 10px;
    color: #fff;
    background: rgba(0, 0, 0, 0.82);
    font-size: 0.9rem;
    line-height: 1.3;
  }

  .yt-status {
    pointer-events: none;
  }

  .yt-status:empty {
    padding: 0;
  }

  .yt-retry,
  .yt-fallback {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: underline;
  }

  .yt-retry[hidden],
  .yt-fallback[hidden] {
    display: none;
  }

  .yt-retry {
    border: 2px solid rgba(255, 255, 255, 0.92);
    cursor: pointer;
    font: inherit;
  }

  .yt-frame :global(.plyr--video.plyr--hide-controls:focus-within .plyr__controls) {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  @media (min-width: 900px) {
    .yt-frame--9x16 {
      width: 380px;
    }
  }
</style>

{hasYouTube || hasSlider ? <script src="../scripts/workMediaDisplayScript.ts"></script> : null}
