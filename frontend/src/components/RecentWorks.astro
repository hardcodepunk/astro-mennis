---
import WorkThumbnailCard from "./WorkThumbnailCard.astro"
import type { WorkSummary } from "../lib/sanity.queries"

const { items = [], compactTop = false } = Astro.props as {
  items: WorkSummary[]
  compactTop?: boolean
}
---

<section class:list={["rw", { "rw--compact-top": compactTop }]}>
  <div class="rw-inner ds-shell ds-shell--wide">
    <h2 class="rw-title ds-title ds-title--large">Keep on watching</h2>

    <div class="rw-grid">
      {items.map(work => <WorkThumbnailCard work={work} headingTag="h3" />)}
    </div>
  </div>

  <style>
    .rw {
      padding: 88px 0;
    }

    .rw--compact-top {
      padding-top: 48px;
    }

    .rw-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.25rem;
    }

    @media (max-width: 1000px) {
      .rw-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 700px) {
      .rw {
        padding: 64px 0;
      }

      .rw--compact-top {
        padding-top: 32px;
      }

      .rw-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</section>
