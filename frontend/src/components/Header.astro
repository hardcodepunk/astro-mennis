---
const NAV = [
  { label: "Projects", href: "/projects" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
]

const { transparentOnTop = false, transparentPaths = [] } = Astro.props
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/"
const isActiveNav = (href: string) => {
  if (href === "/projects") return currentPath === "/projects" || currentPath.startsWith("/projects/") || currentPath.startsWith("/works/")
  return currentPath === href || currentPath.startsWith(`${href}/`)
}
---

<header
  class:list={["site-header fixed top-0 z-50 w-full", !transparentOnTop && "is-solid"]}
  data-header
  data-transparent-on-top={transparentOnTop ? "true" : "false"}
  data-transparent-paths={JSON.stringify(transparentPaths)}
>
  <div class="header-bg" aria-hidden="true"></div>

  <div class="relative flex h-16 items-center justify-between px-6">
    <a
      href="/"
      class="brand font-display text-2xl tracking-widest transition-colors"
      data-brand
    >
      DE MENNIS
    </a>

    <nav class="desktop-nav hidden md:flex items-center gap-8 text-sm font-bold">
      {
        NAV.map(item => (
          <a
            href={item.href}
            class:list={[
              "desktop-link ds-progress-link transition-colors",
              isActiveNav(item.href) && "is-active",
            ]}
            aria-current={isActiveNav(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <button
      type="button"
      class="md:hidden inline-flex items-center justify-center p-2"
      aria-label="Open menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-menu-button
    >
      <span class="hamburger" aria-hidden="true">
        <span class="hamburger__bar"></span>
        <span class="hamburger__bar"></span>
        <span class="hamburger__bar"></span>
      </span>
    </button>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" aria-hidden="true" data-menu-overlay hidden inert>
  <div class="mobile-menu__backdrop" data-menu-backdrop></div>

  <div class="mobile-menu__panel" role="dialog" aria-modal="true" aria-label="Site menu">
    <button class="mobile-menu__close" type="button" aria-label="Close menu" data-menu-close>
      <span class="mobile-menu__close-icon" aria-hidden="true"></span>
    </button>

    <nav class="mobile-menu__nav px-6">
      <div class="mobile-menu__stack font-display text-2xl tracking-widest">
        {
          NAV.map(item => (
            <a
              href={item.href}
              class:list={["mobile-link ds-progress-link", isActiveNav(item.href) && "is-active"]}
              aria-current={isActiveNav(item.href) ? "page" : undefined}
              data-menu-link
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</div>

<style>
  .site-header {
    will-change: transform;
  }

  .header-bg {
    position: absolute;
    inset: 0;
    background: var(--color-brand-primary);
    opacity: 0;
    transform: translateY(-100%);
    transition:
      transform 240ms ease,
      opacity 240ms ease;
    will-change: transform, opacity;
    z-index: 0;
  }

  .site-header.is-solid .header-bg {
    transform: translateY(0);
    opacity: 1;
  }

  .site-header.is-menu-open {
    z-index: 80;
  }

  .brand {
    color: #fff;
  }

  .brand:hover {
    color: var(--color-brand-accent);
    opacity: 1;
  }

  .site-header.is-solid .brand {
    color: var(--color-brand-secondary);
  }

  .site-header.is-solid .brand:hover {
    color: var(--color-brand-accent);
  }

  .desktop-link {
    position: relative;
    display: inline-block;
    padding-bottom: 0.25rem;
    color: #fff;
  }

  .site-header.is-solid .desktop-link {
    color: var(--color-brand-secondary);
  }

  .site-header.is-solid .desktop-link:hover {
    color: var(--color-brand-secondary);
  }

  .desktop-link:hover {
    color: #fff;
  }


  .hamburger {
    width: 28px;
    height: 20px;
    display: inline-flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hamburger__bar {
    height: 3px;
    width: 100%;
    background: rgba(255, 255, 255, 0.92);
    border-radius: 0;
    transform-origin: center;
    transition:
      transform 220ms ease,
      opacity 180ms ease,
      background-color 180ms ease;
  }

  .site-header.is-solid .hamburger__bar {
    background: var(--color-brand-secondary);
  }

  .hamburger.is-open .hamburger__bar:nth-child(1) {
    transform: translateY(8.5px) rotate(45deg);
  }

  .hamburger.is-open .hamburger__bar:nth-child(2) {
    opacity: 0;
  }

  .hamburger.is-open .hamburger__bar:nth-child(3) {
    transform: translateY(-8.5px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 90;
    pointer-events: none;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu__backdrop {
    position: absolute;
    inset: 0;
    background: var(--color-brand-primary);
    opacity: 1;
    transform: translateX(100%);
    transition: transform 240ms ease;
  }

  .mobile-menu__panel {
    position: relative;
    height: 100%;
    width: 100%;
    transform: translateX(100%);
    transition: transform 240ms ease;
  }

  .mobile-menu__close {
    position: absolute;
    top: 0.5rem;
    right: 1.5rem;
    z-index: 1;
    display: grid;
    width: 2.5rem;
    height: 3rem;
    place-items: center;
  }

  .mobile-menu__close-icon,
  .mobile-menu__close-icon::after {
    width: 28px;
    height: 3px;
    background: var(--color-brand-secondary);
    content: "";
  }

  .mobile-menu__close-icon {
    transform: rotate(45deg);
  }

  .mobile-menu__close-icon::after {
    display: block;
    transform: rotate(90deg);
  }

  .mobile-menu__nav {
    height: 100vh;
    display: grid;
    place-items: center;
    text-align: center;
  }

  .mobile-menu__stack {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .mobile-link {
    position: relative;
    color: var(--color-brand-secondary);
    transition:
      color 150ms ease,
      transform 200ms ease,
      opacity 200ms ease;
    opacity: 0;
    transform: translateY(6px);
    display: flex;
    justify-content: center;
    padding-bottom: 0.25rem;
  }

  .mobile-link:hover {
    color: var(--color-brand-secondary);
    opacity: 1;
  }

  .mobile-menu.is-open {
    pointer-events: auto;
  }

  .mobile-menu.is-open .mobile-menu__backdrop {
    transform: translateX(0);
  }

  .mobile-menu.is-open .mobile-menu__panel {
    transform: translateX(0);
  }

  .mobile-menu.is-open .mobile-link {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-menu.is-open .mobile-link:nth-child(1) {
    transition-delay: 40ms;
  }

  .mobile-menu.is-open .mobile-link:nth-child(2) {
    transition-delay: 80ms;
  }

  .mobile-menu.is-open .mobile-link:nth-child(3) {
    transition-delay: 120ms;
  }

  .mobile-menu.is-open .mobile-link:nth-child(4) {
    transition-delay: 160ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .header-bg,
    .hamburger__bar,
    .mobile-menu__backdrop,
    .mobile-menu__panel,
    .mobile-link,
    .brand,
    .desktop-link {
      transition: none !important;
    }
  }
</style>
