---
type Props = {
  sentences: string[]
  mailSentence: string
  email: string
}

const { sentences, mailSentence, email } = Astro.props as Props
const firstSentence = sentences[0] ?? ""
const accessibleSentences = sentences.map(sentence => sentence.trim()).filter(Boolean).join(" ")
const mailHref = `mailto:${email}`
---

<section
  class="contact-page"
  data-contact-typewriter-root
  data-sentences={JSON.stringify(sentences)}
>
  <div class="contact-page__inner ds-shell">
    <div class="contact-page__details">
      <div class="contact-page__intro">
        <p class="contact-page__meta">
          <span class="contact-page__meta-label ds-kicker ds-kicker--small">Based in</span>
          <strong class="ds-title ds-title--card">Ghent, Belgium</strong>
        </p>

        <a class="contact-page__meta contact-page__mail" href={mailHref}>
          <span class="contact-page__meta-label ds-kicker ds-kicker--small">{mailSentence}</span>
          <strong class="contact-page__mail-address ds-title ds-title--card ds-progress-link">{email}</strong>
        </a>
      </div>
    </div>

    <div class="contact-page__headline">
      <span class="sr-only">{accessibleSentences || firstSentence}</span>
      <span aria-hidden="true">
        <span data-contact-typewriter>{firstSentence}</span><span class="contact-page__cursor">|</span>
      </span>
    </div>
  </div>
</section>

<style>
  .contact-page {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: clamp(5rem, 10vh, 7rem) 1.5rem clamp(2rem, 6vh, 4rem);
    background: transparent;
    color: var(--color-brand-secondary);
  }

  .contact-page__inner {
    padding-inline: 1.5rem;
    display: grid;
    gap: clamp(2rem, 5vh, 3.25rem);
  }

  .contact-page__headline {
    min-height: clamp(10rem, 28vw, 20rem);
    max-width: 68rem;
    font-family: var(--font-body);
    font-size: clamp(2.7rem, 7vw, 7rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0;
  }

  .contact-page__cursor {
    display: inline-block;
    margin-left: 0.08em;
    animation: contact-cursor 700ms steps(2, start) infinite;
  }

  .contact-page__details {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }

  .contact-page__intro {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.65rem, 2vw, 1rem) clamp(1.5rem, 4vw, 3rem);
    align-items: baseline;
  }

  .contact-page__meta {
    display: flex;
    align-items: baseline;
    gap: clamp(0.55rem, 1.4vw, 0.85rem);
    margin: 0;
    color: var(--color-brand-secondary);
  }

  .contact-page__meta strong {
    --ds-title-size: clamp(2rem, 5vw, 4.35rem);
    line-height: 0.9;
    overflow-wrap: anywhere;
  }

  .contact-page__mail {
    color: var(--color-brand-secondary);
  }

  .contact-page__mail:hover .contact-page__mail-address::after,
  .contact-page__mail:focus-visible .contact-page__mail-address::after {
    transform: scaleX(1) translateY(var(--ds-progress-offset, 0.14em));
  }

  @keyframes contact-cursor {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0;
    }
  }

  @media (max-width: 760px) {
    .contact-page__headline {
      min-height: 18rem;
    }

    .contact-page__details {
      align-items: flex-start;
      flex-direction: column;
    }

    .contact-page__intro {
      display: grid;
      width: 100%;
    }

    .contact-page__meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.45rem;
    }

  }
</style>
