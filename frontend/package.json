{
  "name": "astro-mennis",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "content:prepare": "node --env-file-if-exists=.env scripts/prepare-content-snapshot.mjs",
    "predev": "npm run content:prepare",
    "dev": "astro dev",
    "prebuild": "npm run content:prepare",
    "build": "astro build",
    "postbuild": "node scripts/verify-built-sitemap.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test && npm --prefix ../shared/media-contract test",
    "typecheck": "astro check",
    "lint": "astro check --minimumSeverity warning --minimumFailingSeverity warning",
    "check": "npm test && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@astro-mennis/media-contract": "file:../shared/media-contract",
    "@fontsource/bebas-neue": "^5.2.7",
    "@portabletext/to-html": "^5.0.1",
    "@sanity/client": "^7.15.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/webhook": "4.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "sanitize-html": "^2.17.6",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/sanitize-html": "^2.16.1",
    "typescript": "^6.0.3"
  }
}
